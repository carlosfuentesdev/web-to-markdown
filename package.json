{
  "name": "@karlangas12/web-to-markdown",
  "version": "0.1.1",
  "type": "module",
  "description": "Turn any web page or raw HTML into clean, dense, LLM-ready Markdown. Runs on Cloudflare Workers, Node, Deno & Bun — CLI + SDK.",
  "license": "MIT",
  "author": "Karlangas12",
  "homepage": "https://github.com/Karlangas12/web-to-markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karlangas12/web-to-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/Karlangas12/web-to-markdown/issues"
  },
  "keywords": [
    "markdown",
    "html-to-markdown",
    "web-to-markdown",
    "readability",
    "content-extraction",
    "scraper",
    "llm",
    "rag",
    "ai",
    "context",
    "cloudflare-workers",
    "edge",
    "cli",
    "developer-tools"
  ],
  "bin": {
    "web-to-markdown": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "node-html-parser": "^9.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
